              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('N2 View allocation: status 200', () => pm.expect(pm.response.code).to.be.oneOf([200]));",
                  "const r = pm.response.json();",
                  "pm.test('no unseated students', () => pm.expect(r.summary.unseated).to.eql(0));",
                  "pm.test('blocked seats B4/C4 not used', () => pm.expect(r.assignments.filter(a => a.hallId == pm.collectionVariables.get('hallA') && ['B4','C4'].includes(a.seat)).length).to.eql(0));",
                  "pm.collectionVariables.set('assignmentId', r.assignments.find(a => a.studentCode === 'S2026010').assignmentId);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
