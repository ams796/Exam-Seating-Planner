      "name": "1 Normal cases",
      "item": [
        {
          "name": "N1 Run allocation (fill-first)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('N1 Run allocation (fill-first): status 201', () => pm.expect(pm.response.code).to.be.oneOf([201]));",
                  "const r = pm.response.json();",
                  "pm.test('every student seated', () => pm.expect(r.studentsSeated).to.eql(50));",
                  "pm.test('Hall A1 filled before Hall B2', () => { pm.expect(r.halls[0].seatsUsed).to.eql(r.halls[0].usableSeats); });",
                  "pm.collectionVariables.set('hallA', r.halls[0].hallId); pm.collectionVariables.set('hallB', r.halls[1].hallId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
