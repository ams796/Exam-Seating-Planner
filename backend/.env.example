# Copy this file to .env and fill in the values. Never commit .env.
PORT=3000
NODE_ENV=development

# Neon connection string. For the app use the least-privilege app_user string (db/least-privilege.sql).
# For "npm run seed" use the OWNER string once (the seed needs TRUNCATE).
DATABASE_URL=

# Frontend origins allowed by CORS, comma-separated, no trailing slash.
CORS_ORIGINS=http://localhost:8080

# Lab 8 rate limits (requests per minute per IP)
RATE_LIMIT_MAX=120
LOGIN_RATE_LIMIT_MAX=10

# Only used by "npm run seed" (demo accounts' password). Set it in your terminal, not in Git.
SEED_PASSWORD=
